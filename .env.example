# happy-one 运行配置示例。复制为 .env 后按需修改，.env 不得提交。
# 所有变量均为可选，未设置时使用括号内默认值。

# 服务
HAPPYONE_ENV=dev
HAPPYONE_HOST=127.0.0.1
HAPPYONE_PORT=8787
HAPPYONE_LOG_LEVEL=INFO
# 对外 issuer，必须与客户端配置一致（默认 http://127.0.0.1:8787）
HAPPYONE_ISSUER=http://127.0.0.1:8787

# 数据目录（默认 ./data）
HAPPYONE_DATA_DIR=./data
# SQLite 文件（默认 <data_dir>/happyone.db）
# HAPPYONE_DB_PATH=./data/happyone.db
# OIDC Ed25519 私钥（默认 <data_dir>/keys/oidc_ed25519.pem）
# HAPPYONE_OIDC_KEY_PATH=./data/keys/oidc_ed25519.pem

# 令牌有效期（秒）
HAPPYONE_SESSION_TTL_SEC=604800
HAPPYONE_ACCESS_TOKEN_TTL_SEC=3600
HAPPYONE_REFRESH_TOKEN_TTL_SEC=2592000
HAPPYONE_AUTH_CODE_TTL_SEC=300
HAPPYONE_DEVICE_CODE_TTL_SEC=600
HAPPYONE_DEVICE_POLL_INTERVAL_SEC=5

# 首次启动引导管理员（仅当 users 表为空时生效，用后建议删除）
# HAPPYONE_BOOTSTRAP_ADMIN_USERNAME=admin
# HAPPYONE_BOOTSTRAP_ADMIN_PASSWORD=

# 内容面（happy-hub）——由存储接入线使用，禁止下发到客户端
# HAPPYONE_HUB_BASE_URL=http://192.168.2.16:8090
# HAPPYONE_HUB_TOKEN=
# HAPPYONE_HUB_TIMEOUT_SEC=10
# HAPPYONE_HUB_MAX_RETRIES=2
# HAPPYONE_HUB_SECRET_PATH=

# 产物分发
# HAPPYONE_STORAGE_CHUNK_SIZE=8388608
# HAPPYONE_STORAGE_MULTIPART_THRESHOLD=8388608
# HAPPYONE_STORAGE_SIGN_TTL_SEC=300

# 许可证（密钥必须与 hub .secret、OIDC 密钥分离）
# HAPPYONE_LICENSE_KEY_PATH=./data/keys/license_ed25519.pem
# HAPPYONE_LICENSE_GRACE_DAYS=7

# 通道信令
# HAPPYONE_CHANNEL_PAIR_CODE_TTL=600
# HAPPYONE_CHANNEL_SESSION_TTL=1800
# HAPPYONE_CHANNEL_HEARTBEAT_TIMEOUT=30
# HAPPYONE_CHANNEL_SWEEP_INTERVAL=30
# HAPPYONE_CHANNEL_MAX_SESSIONS=64
# HAPPYONE_CHANNEL_MAX_SIGNAL_BYTES=65536

# 人机验证（不配置时自动生成并持久化到 <data_dir>/keys/captcha_secret）
# HAPPYONE_CAPTCHA_SECRET=
